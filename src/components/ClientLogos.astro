---
// Client logo band. Files live in public/logos/.
// Every client has a real logo now. If one is ever added without a file,
// give it a wordmark image rather than reintroducing a text fallback: a lone
// text entry in a row of logos looks like a bug.
const clients = [
  { name: 'Willow', src: '/logos/willow.png', h: 'h-7' },
  { name: 'Will', src: '/logos/will.svg', h: 'h-7' },
  { name: 'SOFICO', src: '/logos/sofico.png', h: 'h-7' },
  { name: 'Aspire', src: '/logos/aspire.svg', h: 'h-6' },
  { name: 'ZYGO', src: '/logos/zygo.png', h: 'h-6' },
];
---

<section class="border-y border-divider bg-bg-secondary dotfield py-14">
  <div class="max-w-6xl mx-auto px-6">
    <p class="text-xs text-text-secondary font-body uppercase tracking-widest mb-9 text-center">
      Past and current work
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-8 max-w-3xl mx-auto">
      {clients.map((c) => (
        <img
          src={c.src}
          alt={c.name}
          class={`${c.h} w-auto object-contain opacity-60 hover:opacity-100 transition-opacity duration-200`}
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>
