---
export interface Props {
  title: string;
  slug: string;
  meta_description: string;
  category: string;
  published_at?: Date;
}

const { title, slug, meta_description, category, published_at } = Astro.props;

const categoryColors: Record<string, string> = {
  'Diagnose': 'bg-coral/10 text-coral',
  'Build':    'bg-saffron/10 text-amber-700',
  'Grow':     'bg-bg-secondary text-text-secondary',
  'Learn':    'bg-bg-secondary text-text-secondary',
};
---

<a
  href={`/blog/${slug}`}
  class="group flex flex-col h-full bg-white rounded p-6 border border-divider hover:border-coral/40 hover:shadow-sm transition-all"
>
  <div class="flex items-center gap-3 mb-3">
    <span class={`text-xs font-body font-600 px-2.5 py-1 rounded ${categoryColors[category] ?? 'bg-bg-secondary text-text-secondary'}`}>
      {category}
    </span>
    {published_at && (
      <time class="text-xs text-text-secondary font-body" datetime={published_at.toISOString()}>
        {published_at.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
      </time>
    )}
  </div>
  <h2 class="font-display font-500 text-lg text-text-main leading-snug mb-2 group-hover:text-coral transition-colors">
    {title}
  </h2>
  <p class="text-sm text-text-secondary font-body leading-relaxed line-clamp-3">
    {meta_description}
  </p>
</a>
