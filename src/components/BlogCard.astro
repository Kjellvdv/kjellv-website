---
import { styleFor } from '../data/categories';

export interface Props {
  title: string;
  slug: string;
  meta_description: string;
  category: string;
  published_at?: Date;
}

const { title, slug, meta_description, category, published_at } = Astro.props;
const s = styleFor(category);
---

<a
  href={`/blog/${slug}`}
  class={`group relative flex flex-col h-full bg-white rounded-2xl p-6 pt-7 border border-divider ${s.border} hover:shadow-[0_8px_24px_-12px_rgba(43,43,43,0.18)] hover:-translate-y-0.5 transition-all duration-200 overflow-hidden`}
>
  <!-- category accent, grows across the card edge on hover -->
  <span
    class={`absolute top-0 left-0 h-[3px] w-12 ${s.bar} rounded-b transition-all duration-300 group-hover:w-full`}
    aria-hidden="true"
  ></span>

  <div class="flex items-center gap-3 mb-3">
    <span class={`text-xs font-body font-600 px-2.5 py-1 rounded-full ${s.badge}`}>
      {category}
    </span>
    {published_at && (
      <time class="text-xs text-text-secondary font-body" datetime={published_at.toISOString()}>
        {published_at.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
      </time>
    )}
  </div>

  <h2 class="font-display font-500 text-lg text-text-main leading-snug mb-2 transition-colors" style={`--hover:${s.hex}`}>
    <span class="group-hover:text-[var(--hover)]">{title}</span>
  </h2>

  <p class="text-sm text-text-secondary font-body leading-relaxed line-clamp-3">
    {meta_description}
  </p>
</a>
