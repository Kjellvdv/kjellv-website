---
---

<footer class="bg-text-main mt-0">
  <div class="max-w-5xl mx-auto px-6 py-14">

    <!-- Main footer row -->
    <div class="flex flex-col sm:flex-row items-start justify-between gap-10 pb-10" style="border-bottom: 1px solid rgba(255,255,255,0.08);">

      <!-- Brand -->
      <div class="max-w-xs">
        <p class="font-display font-600 text-xl text-white mb-3">Very Klear</p>
        <p class="text-sm font-body leading-relaxed" style="color: rgba(255,255,255,0.45);">
          Fractional marketing leadership for B2B tech. Strategy and execution from the same person.
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-col gap-3 sm:items-end">
        <a
          href="https://tidycal.com/kjellvandevyvere/discovery"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-body font-600 text-coral hover:text-coral/80 transition-colors"
        >
          Book a call →
        </a>
        <a
          href="/blog"
          class="text-sm font-body transition-colors"
          style="color: rgba(255,255,255,0.45);"
          onmouseover="this.style.color='rgba(255,255,255,0.8)'"
          onmouseout="this.style.color='rgba(255,255,255,0.45)'"
        >
          Articles
        </a>
        <a
          href="https://linkedin.com/in/kjellvandevyvere"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-body transition-colors"
          style="color: rgba(255,255,255,0.45);"
          onmouseover="this.style.color='rgba(255,255,255,0.8)'"
          onmouseout="this.style.color='rgba(255,255,255,0.45)'"
        >
          LinkedIn
        </a>
        <a
          href="mailto:kjell@veryklear.be"
          class="text-sm font-body transition-colors"
          style="color: rgba(255,255,255,0.45);"
          onmouseover="this.style.color='rgba(255,255,255,0.8)'"
          onmouseout="this.style.color='rgba(255,255,255,0.45)'"
        >
          kjell@veryklear.be
        </a>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p class="text-xs font-body" style="color: rgba(255,255,255,0.25);">
        © {new Date().getFullYear()} Very Klear. All rights reserved.
      </p>
      <a
        href="/privacy"
        class="text-xs font-body transition-colors"
        style="color: rgba(255,255,255,0.35);"
        onmouseover="this.style.color='rgba(255,255,255,0.7)'"
        onmouseout="this.style.color='rgba(255,255,255,0.35)'"
      >
        Privacy policy
      </a>
    </div>

  </div>
</footer>
