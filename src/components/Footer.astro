---
// Band surface, same as the client-logo strip. The coral CTA above it is the
// page's one loud moment, so the footer stays quiet and lets it land.
---

<footer class="bg-bg-secondary border-t border-divider">
  <div class="max-w-5xl mx-auto px-6 py-14">

    <!-- Main footer row -->
    <div class="flex flex-col sm:flex-row items-start justify-between gap-10 pb-10 border-b border-divider">

      <!-- Brand -->
      <div class="max-w-xs">
        <p class="font-display font-600 text-xl text-text-main mb-3">Kjell Vandevyvere</p>
        <p class="text-sm font-body leading-relaxed text-text-secondary">
          Fractional marketing leadership for B2B tech. Strategy and execution from the same person.
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-col gap-3 sm:items-end">
        <a
          href="https://www.linkedin.com/in/kjellvandevyvere/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-body font-600 text-coral hover:text-coral/80 transition-colors"
        >
          LinkedIn →
        </a>
        <a href="/now" class="text-sm font-body text-text-secondary hover:text-text-main transition-colors">
          Now page
        </a>
        <a href="/work" class="text-sm font-body text-text-secondary hover:text-text-main transition-colors">
          Work
        </a>
        <a href="/blog" class="text-sm font-body text-text-secondary hover:text-text-main transition-colors">
          Articles
        </a>
        <a
          href="mailto:kjell@kjellv.com"
          class="text-sm font-body text-text-secondary hover:text-text-main transition-colors"
        >
          kjell@kjellv.com
        </a>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p class="text-xs font-body text-text-secondary">
        © {new Date().getFullYear()} Kjell Vandevyvere. All rights reserved.
      </p>
      <a href="/privacy" class="text-xs font-body text-text-secondary hover:text-text-main transition-colors">
        Privacy policy
      </a>
    </div>

  </div>
</footer>
