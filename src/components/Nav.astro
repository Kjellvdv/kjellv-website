---
const { currentPath = '' } = Astro.props;
---

<header class="border-b border-divider bg-bg-primary sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center hover:opacity-80 transition-opacity font-display font-600 text-lg text-text-main" aria-label="Kjell Vandevyvere home">
      Kjell Vandevyvere
    </a>

    <div class="flex items-center gap-7">
      <a
        href="/fractional-marketing"
        class={`text-sm font-body transition-colors relative ${
          currentPath.startsWith('/fractional-marketing')
            ? 'text-coral'
            : 'text-text-secondary hover:text-text-main'
        }`}
      >
        Fractional marketing
        {currentPath.startsWith('/fractional-marketing') && (
          <span class="absolute -bottom-0.5 left-0 right-0 h-px bg-coral block"></span>
        )}
      </a>
      <a
        href="/work"
        class={`text-sm font-body transition-colors relative ${
          currentPath.startsWith('/work')
            ? 'text-coral'
            : 'text-text-secondary hover:text-text-main'
        }`}
      >
        Work
        {currentPath.startsWith('/work') && (
          <span class="absolute -bottom-0.5 left-0 right-0 h-px bg-coral block"></span>
        )}
      </a>
      <a
        href="/speaking"
        class={`text-sm font-body transition-colors relative ${
          currentPath.startsWith('/speaking')
            ? 'text-coral'
            : 'text-text-secondary hover:text-text-main'
        }`}
      >
        Speaking
        {currentPath.startsWith('/speaking') && (
          <span class="absolute -bottom-0.5 left-0 right-0 h-px bg-coral block"></span>
        )}
      </a>
      <a
        href="/blog"
        class={`text-sm font-body transition-colors relative ${
          currentPath.startsWith('/blog')
            ? 'text-coral'
            : 'text-text-secondary hover:text-text-main'
        }`}
      >
        Articles
        {currentPath.startsWith('/blog') && (
          <span class="absolute -bottom-0.5 left-0 right-0 h-px bg-coral block"></span>
        )}
      </a>
      <a
        href="/now"
        class={`text-sm font-body transition-colors relative ${
          currentPath.startsWith('/now')
            ? 'text-coral'
            : 'text-text-secondary hover:text-text-main'
        }`}
      >
        About
        {currentPath.startsWith('/now') && (
          <span class="absolute -bottom-0.5 left-0 right-0 h-px bg-coral block"></span>
        )}
      </a>
      <a
        href="https://www.linkedin.com/in/kjellvandevyvere/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-secondary hover:text-coral transition-colors"
        aria-label="Kjell Vandevyvere on LinkedIn"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"></path>
        </svg>
      </a>
      <a
        href="mailto:kjell@kjellv.com"
        class="bg-text-main text-white text-sm font-body font-600 px-5 py-2 rounded-full hover:bg-coral transition-colors"
      >
        Get in touch
      </a>
    </div>

  </nav>
</header>
