---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { cases, caseStudies } from '../data/cases';

// The card data lives in src/data/cases.ts, shared with the full case pages.
// A card only links through once its full case study is published (or, on the
// dev server, drafted).
const studies = await caseStudies();
---

<BaseLayout
  title="Work — Kjell Vandevyvere"
  description="Selected client work: Willow, ZYGO, SOFICO and Aspire. What each company does, what I was brought in for, and what actually got built."
>
  <Nav currentPath="/work" />

  <main>

    <!-- ─── HERO ─────────────────────────────────────────────────── -->
    <section class="max-w-6xl mx-auto px-6 pt-24 pb-20">
      <div class="max-w-3xl">
        <h1 class="font-display font-600 text-4xl sm:text-5xl lg:text-[3.25rem] wonk leading-[1.05] text-text-main mb-6">
          Selected <span class="text-coral">work</span>.
        </h1>
        <p class="text-lg text-text-secondary font-body leading-relaxed max-w-xl">
          A few of the companies I work with, what they do, and what I was actually brought in to build. Sometimes that's the whole marketing function. More often it's the part of it nobody was owning.
        </p>
      </div>
    </section>

    <!-- ─── CASES ─────────────────────────────────────────────────── -->
    <section class="max-w-6xl mx-auto px-6 pb-24">
      <div class="flex flex-col gap-6">
        {cases.map((c) => {
          const study = studies.get(c.slug);
          return (
          <article id={c.slug} class="scroll-mt-28 bg-white rounded-3xl border border-divider shadow-soft hover:shadow-lift transition-shadow duration-200 overflow-hidden">
            <div class="grid md:grid-cols-[280px_1fr]">

              <!-- left rail -->
              <div class="p-8 sm:p-10 flex flex-col gap-6 border-b md:border-b-0 md:border-r border-divider">
                <div class="min-h-[2rem] flex items-center">
                  {c.logo ? (
                    <img src={c.logo} alt={c.name} class={`${c.logoClass} w-auto object-contain`} loading="lazy" />
                  ) : (
                    <span class="font-display font-600 text-2xl tracking-tight text-text-main">{c.name}</span>
                  )}
                </div>
                <dl class="space-y-4">
                  <div>
                    <dt class="text-xs font-body font-600 uppercase tracking-wider text-text-secondary mb-1">Sector</dt>
                    <dd class="text-sm font-body text-text-main">{c.sector}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-body font-600 uppercase tracking-wider text-text-secondary mb-1">My role</dt>
                    <dd class="text-sm font-body text-text-main">{c.role}</dd>
                  </div>
                  {c.duration && (
                    <div>
                      <dt class="text-xs font-body font-600 uppercase tracking-wider text-text-secondary mb-1">Length</dt>
                      <dd class="text-sm font-body text-text-main">{c.duration}</dd>
                    </div>
                  )}
                </dl>
              </div>

              <!-- body -->
              <div class="p-8 sm:p-10">
                <p class="text-base font-body text-text-main leading-relaxed mb-8">
                  {c.what}
                </p>
                <p class="text-xs font-body font-600 uppercase tracking-wider text-coral mb-5">
                  What I built
                </p>
                <ul class="space-y-3">
                  {c.did.map((item) => (
                    <li class="flex items-start gap-3 text-sm font-body text-text-secondary leading-relaxed">
                      <span class="mt-2 w-1.5 h-1.5 rounded-full bg-saffron flex-shrink-0" aria-hidden="true"></span>
                      {item}
                    </li>
                  ))}
                </ul>
                {study && (
                  <a
                    href={`/work/${c.slug}/`}
                    class="mt-8 inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-divider text-sm font-body font-600 text-text-main hover:border-coral hover:text-coral transition-colors"
                  >
                    Read the full case study <span aria-hidden="true">&rarr;</span>
                    {study.entry.data.status !== 'published' && (
                      <span class="ml-1 text-xs font-500 px-2 py-0.5 rounded-full bg-saffron/20">draft</span>
                    )}
                  </a>
                )}
              </div>

            </div>
          </article>
          );
        })}
      </div>
    </section>

    <!--
      All five clients in the logo band now have a case. The Will entry is
      built from kjellv.com's own record (the /now entry of 17 April 2025 and
      the September 2025 career post) rather than a brief, so the role and
      dates are the parts most worth checking.
    -->

    <ContactCTA
      heading="Recognise your own situation in one of these?"
      body="Most of this work started with someone who knew something was off but couldn't name which part. That's a good place to start a conversation."
    />

  </main>

  <Footer />
</BaseLayout>
