---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { styleFor } from '../../data/categories';

const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');
const posts = allPosts.sort((a, b) => {
  const dateA = a.data.published_at ?? new Date(0);
  const dateB = b.data.published_at ?? new Date(0);
  return dateB.getTime() - dateA.getTime();
});

const categories = ['All', 'Marketing', 'Writing', 'Personal', 'AI'] as const;
---

<BaseLayout
  title="Articles — Kjell Vandevyvere"
  description="Writing on marketing, positioning, the craft of writing, and what AI actually changes about the work."
>
  <Nav currentPath="/blog" />

  <main class="max-w-5xl mx-auto px-6 py-16">

    <!-- Header -->
    <div class="mb-12">
      <h1 class="font-display font-600 text-3xl sm:text-4xl text-text-main mb-3">Articles</h1>
      <p class="text-text-secondary font-body leading-relaxed max-w-lg">
        On B2B tech GTM, positioning, customer journeys, and what actually moves the needle. No buzzwords. No frameworks for their own sake.
      </p>
    </div>

    <!-- Category filter -->
    <div class="flex flex-wrap gap-2 mb-10" id="category-filter">
      {categories.map((cat) => {
        const s = cat === 'All' ? null : styleFor(cat);
        return (
          <button
            data-category={cat}
            data-active-class={s ? s.active : 'bg-text-main text-white border-text-main'}
            class={`category-btn text-sm font-body px-4 py-1.5 rounded-full border transition-all cursor-pointer
              ${cat === 'All'
                ? 'bg-text-main text-white border-text-main'
                : `bg-white text-text-secondary border-divider ${s.border} hover:text-text-main`
              }`}
          >
            {cat}
          </button>
        );
      })}
    </div>

    <!-- Posts grid -->
    {posts.length === 0 ? (
      <div class="py-24 text-center">
        <p class="text-text-secondary font-body">Articles coming soon.</p>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="posts-grid">
        {posts.map((post) => (
          <div data-post-category={post.data.category} class="post-item h-full">
            <BlogCard
              title={post.data.title}
              slug={post.slug}
              meta_description={post.data.meta_description}
              category={post.data.category}
              published_at={post.data.published_at}
            />
          </div>
        ))}
      </div>
    )}

    <!-- No results -->
    <div id="no-results" class="py-16 text-center hidden">
      <p class="text-text-secondary font-body">No articles in this category yet.</p>
    </div>

  </main>

  <Footer />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.category-btn');
  const items = document.querySelectorAll<HTMLElement>('.post-item');
  const noResults = document.getElementById('no-results');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.category ?? 'All';

      // Update button styles. Each button carries its own category accent in
      // data-active-class, so the active pill matches the category colour.
      const inactive = ['bg-white', 'text-text-secondary', 'border-divider'];
      buttons.forEach((b) => {
        const isActive = b.dataset.category === selected;
        const active = (b.dataset.activeClass ?? 'bg-text-main text-white border-text-main').split(' ');
        active.forEach((c) => b.classList.toggle(c, isActive));
        inactive.forEach((c) => b.classList.toggle(c, !isActive));
      });

      // Filter posts
      let visible = 0;
      items.forEach((item) => {
        const match = selected === 'All' || item.dataset.postCategory === selected;
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      noResults?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
