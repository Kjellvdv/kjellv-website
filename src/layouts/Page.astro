---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Layout for standalone markdown pages under src/pages/*.md (e.g. /now).
// Astro passes a markdown page's frontmatter in as `frontmatter`.
const { frontmatter } = Astro.props;
const { title, description } = frontmatter ?? {};

// Don't suffix the name onto a title that already carries it.
const pageTitle = title?.includes('Kjell Vandevyvere') ? title : `${title} — Kjell Vandevyvere`;
---

<BaseLayout title={pageTitle} description={description}>
  <Nav currentPath={Astro.url.pathname} />

  <div class="border-b border-divider bg-bg-secondary">
    <div class="max-w-3xl mx-auto px-6 pt-14 pb-12">
      <h1 class="font-display font-600 text-3xl sm:text-4xl lg:text-5xl leading-[1.1] text-text-main mb-5">
        {title}
      </h1>
      {description && (
        <p class="text-lg text-text-secondary font-body leading-relaxed max-w-2xl">
          {description}
        </p>
      )}
    </div>
  </div>

  <main class="max-w-3xl mx-auto px-6 py-14">
    <article class="prose prose-lg max-w-none
      prose-headings:font-display prose-headings:font-600 prose-headings:text-text-main
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-text-main prose-p:leading-relaxed prose-p:font-body
      prose-a:text-coral prose-a:font-600 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-text-main prose-strong:font-700
      prose-li:text-text-main prose-li:font-body
      prose-img:rounded-2xl
      prose-blockquote:border-l-coral prose-blockquote:border-l-4 prose-blockquote:pl-5 prose-blockquote:not-italic prose-blockquote:text-text-secondary
      prose-hr:border-divider
      prose-code:bg-bg-secondary prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none">
      <slot />
    </article>
  </main>

  <Footer />
</BaseLayout>
