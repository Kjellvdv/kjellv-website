  RewriteRule ^27\-book\-marketing\-ideas/?$ /blog/27-book-marketing-ideas [R=301,L]
  RewriteRule ^kjells\-2021\-review/?$ /blog/kjells-2021-review [R=301,L]
  RewriteRule ^how\-to\-make\-sure\-your\-online\-writings\-fulfil\-their\-purpose/?$ /blog/how-to-make-sure-your-online-writings-fulfil-their-purpose [R=301,L]
  RewriteRule ^writing\-clearly/?$ /blog/writing-clearly [R=301,L]
  RewriteRule ^from\-niche\-to\-personal\-brand/?$ /blog/from-niche-to-personal-brand [R=301,L]
  RewriteRule ^short\-bio/?$ /blog/short-bio [R=301,L]
  RewriteRule ^28\-lessons\-about\-life/?$ /blog/28-lessons-about-life [R=301,L]
  RewriteRule ^lines\-of\-writing\-advice/?$ /blog/lines-of-writing-advice [R=301,L]
  RewriteRule ^david\-perells\-three\-plates\-of\-ideas/?$ /blog/david-perells-three-plates-of-ideas [R=301,L]
  RewriteRule ^control\-distractions\-at\-home/?$ /blog/control-distractions-at-home [R=301,L]
  RewriteRule ^writing\-a\-blog\-post/?$ /blog/writing-a-blog-post [R=301,L]
  RewriteRule ^how\-to\-review/?$ /blog/how-to-review [R=301,L]
  RewriteRule ^words\-to\-avoid/?$ /blog/words-to-avoid [R=301,L]
  RewriteRule ^write\-with\-clarity/?$ /blog/write-with-clarity [R=301,L]
  RewriteRule ^the\-power\-of\-words/?$ /blog/the-power-of-words [R=301,L]
  RewriteRule ^creating\-a\-landing\-page/?$ /blog/creating-a-landing-page [R=301,L]
  RewriteRule ^why\-people\-write/?$ /blog/why-people-write [R=301,L]
  RewriteRule ^writing\-advice\-guides/?$ /blog/writing-advice-guides [R=301,L]
  RewriteRule ^write\-this\-not\-that\-joshua\-lisec/?$ /blog/write-this-not-that-joshua-lisec [R=301,L]
