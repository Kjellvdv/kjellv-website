# Cache hashed assets (Astro _astro/ files) for 1 year
<IfModule mod_headers.c>
  <FilesMatch "\.[a-zA-Z0-9]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# HTML pages: short cache, always revalidate
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- WordPress -> Astro redirects (added at migration, 2026-08-25) ---
# kjellv.com served posts at /<slug>/; this site serves them at /blog/<slug>.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^how\-i\-publish\-one\-success\-story\-every\-single\-week\-and\-how\-you\-can\-too/?$ /blog/how-i-publish-one-success-story-every-single-week-and-how-you-can-too [R=301,L]
  RewriteRule ^how\-social\-media\-shaped\-my\-career\-and\-changed\-my\-life/?$ /blog/how-social-media-shaped-my-career-and-changed-my-life [R=301,L]
  RewriteRule ^some\-thoughts\-on\-business\-and\-marketing/?$ /blog/some-thoughts-on-business-and-marketing [R=301,L]
  RewriteRule ^veggie\-challenge/?$ /blog/veggie-challenge [R=301,L]
